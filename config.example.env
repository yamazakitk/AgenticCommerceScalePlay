# =============================================================================
# Harvest & Co. デモ環境の設定ファイル
#
#   cp config.example.env config.env   して、config.env を編集してから
#   ./setup.sh を実行してください。
#
# 必須なのは PROJECT_ID だけです。他はすべて既定値のままで動きます。
# (config.env は .gitignore 済みです)
# =============================================================================

# --- 必須 -------------------------------------------------------------------

# デプロイ先の Google Cloud プロジェクトID
PROJECT_ID=


# --- リージョン --------------------------------------------------------------

# EC サイト / 検索 API / Firestore のリージョン
REGION=asia-northeast1

# MCP サーバーのリージョン
MCP_REGION=us-central1

# CX Agent Studio (CES) アプリのロケーション。現状 us / eu のみ
CES_LOCATION=us


# --- Cloud Run サービス名 -----------------------------------------------------

SITE_SERVICE=agentic-commerce
SEARCH_API_SERVICE=harvest-search-api
MCP_SERVICE=harvest-commerce-mcp


# --- AI Commerce Search (Retail API) -----------------------------------------

CATALOG_LOCATION=global
CATALOG_ID=default_catalog
BRANCH_ID=default_branch
SERVING_CONFIG_ID=default_search

# 結果が少ないときに関連商品で補完する。DISABLED にすると完全一致のみ
QUERY_EXPANSION=AUTO

# カタログ取り込みの中継に使う GCS バケット。空なら <PROJECT_ID>-harvest-setup を作成
GCS_BUCKET=


# --- Firestore ---------------------------------------------------------------

FIRESTORE_COLLECTION=products


# --- CX Agent Studio ----------------------------------------------------------

# 作成する CES アプリのID (英小文字・数字・ハイフン)
CES_APP_ID=harvest-commerce

# 公開アクセス付き WEB_UI デプロイメントのID
CES_DEPLOYMENT_ID=web-widget

# true にすると setup.sh 実行のたびに agent/ces-app/ の定義でアプリを上書きします。
# コンソールで編集した内容は失われるため、既定は false (既存アプリがあれば取り込みをスキップ)
FORCE_AGENT_IMPORT=false


# --- サイトの URL / オリジン ---------------------------------------------------

# 通常は空のままにしてください。Cloud Run にデプロイ済みのサービスから自動取得します。
# 独自ドメインを使う場合のみ、そのURLを指定します (末尾スラッシュなし)
SITE_URL=

# 上記に加えて許可するオリジン (カンマ区切り)。ローカル開発用など
EXTRA_ALLOWED_ORIGINS=http://localhost:8099


# --- Firebase (任意) ----------------------------------------------------------
#
# 空のままにしておくと setup.sh が Firebase ウェブアプリを自動作成し、構成を取得します。
# 既存のウェブアプリを使いたい場合のみ、Firebase コンソールの値を貼り付けてください。
# 取得に失敗した場合、サイトは js/products.js のローカルカタログで動作します
# (デモとしては問題なく動きます)。

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
